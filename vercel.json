{
  "version": 2,
  "buildCommand": "prisma generate && vite build",
  "installCommand": "npm install && prisma generate",
  "builds": [
    {
      "src": "api/prisma.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/blog-posts.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/page-content.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/research-projects.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/team-members.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/users.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.ts"
    },
    {
      "src": "/api/blog-posts(.*)",
      "dest": "/api/blog-posts.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/page-content(.*)",
      "dest": "/api/page-content.ts"
    },
    {
      "src": "/api/research-projects(.*)",
      "dest": "/api/research-projects.ts"
    },
    {
      "src": "/api/team-members(.*)",
      "dest": "/api/team-members.ts"
    },
    {
      "src": "/api/users(.*)",
      "dest": "/api/users.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
