// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for role-based access control
enum UserRole {
  VISITOR
  TEAM_MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

// Main user model with authentication and profile information
model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String     // Hashed password
  name              String
  role              UserRole   @default(VISITOR)
  status            UserStatus @default(APPROVED) // Default approved for existing users
  emailVerified     Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  // Profile information
  bio               String?
  researchInterests String[]   @default([])
  photoUrl          String?
  isPublic          Boolean    @default(true)  // Visible on public team page
  
  // Relationships
  authoredPosts      Post[]
  authoredPapers     ResearchPaper[]
  submittedApplications Application[] @relation(name: "submitted_applications")
  reviewedApplications Application[] @relation(name: "reviewed_applications")
  
  @@map("users")
}

// Research papers model
model ResearchPaper {
  id            String        @id @default(uuid())
  title         String
  authors       String[]      // Array of author names/IDs
  abstract      String
  publishedDate DateTime      // Publication date
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relationships
  author        User          @relation(fields: [authorId], references: [id])
  authorId      String
  
  @@map("research_papers")
}

// Blog posts model
model Post {
  id            String        @id @default(uuid())
  title         String
  content       String        // Markdown or HTML content
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     // When it was published
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relationships
  author        User          @relation(fields: [authorId], references: [id])
  authorId      String
  
  @@map("blog_posts")
}

// Team member applications
model Application {
  id            String     @id @default(uuid())
  email         String
  name          String
  motivation    String     // Statement of purpose
  cvUrl         String     // URL to uploaded CV
  status        UserStatus @default(PENDING)
  feedback      String?    // Admin feedback for rejections/changes
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Review information
  applicantId   String
  applicant     User       @relation(name: "submitted_applications", fields: [applicantId], references: [id])
  
  @@map("applications")
}
