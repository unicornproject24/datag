// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for role-based access control
enum UserRole {
  VISITOR
  TEAM_MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

// Main user model with authentication and profile information
model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String     // Hashed password
  name              String
  role              UserRole   @default(VISITOR)
  status            UserStatus @default(APPROVED) // Default approved for existing users
  emailVerified     Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  // Profile information
  bio               String?
  researchInterests String[]   @default([])
  photoUrl          String?
  isPublic          Boolean    @default(true)  // Visible on public team page
  
  // Relationships
  authoredPapers     ResearchPaper[]
  submittedApplications Application[] @relation(name: "UserSubmittedApplications")
  reviewedApplications Application[] @relation(name: "UserReviewedApplications")
  
  @@map("users")
}

// Research papers model
model ResearchPaper {
  id            String        @id @default(uuid())
  title         String
  authors       String[]      // Array of author names/IDs
  abstract      String
  publishedDate DateTime      // Publication date
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relationships
  author        User          @relation(fields: [authorId], references: [id])
  authorId      String
  
  @@map("research_papers")
}

// Team member applications
model Application {
  id            String     @id @default(uuid())
  email         String
  name          String
  motivation    String     // Statement of purpose
  cvUrl         String     // URL to uploaded CV
  status        UserStatus @default(PENDING)
  feedback      String?    // Admin feedback for rejections/changes
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Relations
  applicantId   String
  applicant     User       @relation(name: "UserSubmittedApplications", fields: [applicantId], references: [id])
  reviewerId    String?
  reviewer      User?      @relation(name: "UserReviewedApplications", fields: [reviewerId], references: [id])
  
  @@map("applications")
}

// Team member model for the public team page
model TeamMember {
  id                String   @id @default(uuid())
  name              String
  preferredName     String?
  role              String
  bio               String
  expertise         String[]
  researchInterests String[] @default([])
  projects          Json?    // Array of {title, description} objects
  education         String?
  links             Json?    // {linkedIn, orcid, googleScholar, website, youtube}
  imageUrl          String
  consentGiven      Boolean  @default(false)
  consentName       String?
  consentDate       DateTime?
  isPublic          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("team_members")
}

// Blog post model for the admin panel
model BlogPost {
  id          String   @id @default(uuid())
  title       String
  excerpt     String
  content     String   @default("") // Full blog post content
  author      String
  authorImage String
  category    String   @default("General")
  tags        String[] @default([])
  imageUrl    String   @default("")
  readTime    String
  isPublic    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

// Research project model for the admin panel
model ResearchProject {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String
  tags        String[]
  imageUrl    String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("research_projects")
}

// Partner model for the admin panel
model Partner {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partners")
}

// Page content model for editable static pages
model PageContent {
  id          String   @id @default(uuid())
  pageKey     String   // e.g., "homepage", "aboutpage"
  section     String   // e.g., "hero", "approach", "stats", etc.
  contentKey  String   // e.g., "title", "description", "stat1_value"
  contentValue String  @db.Text
  metadata    Json?    // Additional metadata like image URLs, counts, etc.
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageKey, section, contentKey])
  @@map("page_contents")
}